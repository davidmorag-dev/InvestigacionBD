table FOOD_INSPECTIONS_CLEAN
	lineageTag: 47688304-88fb-453a-b81e-8d5e56878a77

	measure 'Total Fail' =
			
			CALCULATE(
			    COUNTROWS(FOOD_INSPECTIONS_CLEAN),
			    FOOD_INSPECTIONS_CLEAN[RESULTS] = "Fail"
			)
		formatString: #,0
		lineageTag: 3fdc6bf5-c1a5-4a28-b952-522dbda59b01

	measure 'Total Inspecciones' =
			
			COUNTROWS(FOOD_INSPECTIONS_CLEAN)
		formatString: #,0
		lineageTag: 62b03a1c-b7bc-4f5d-9085-f9f2d4354565

	measure 'Fail %' =
			
			DIVIDE(
			    [Total Fail],
			    [Total Inspecciones]
			)
		formatString: 0.00%
		lineageTag: fdb770f0-a359-4a5c-b4a9-f622747fc889


